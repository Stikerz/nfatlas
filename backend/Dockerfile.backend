FROM python:3.13-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src/ ./src/

RUN pip install --prefix=/install "."

FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN groupadd --system atlas && useradd --system --gid atlas atlas

COPY --from=builder /install /usr/local
COPY --chown=atlas:atlas src/ ./src/
COPY --chown=atlas:atlas migrations/ ./migrations/

USER atlas

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/healthz', timeout=2); sys.exit(0)" || exit 1

CMD ["uvicorn", "atlas.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ── Dev image ─────────────────────────────────────────────────────────────
# Adds the [dev] extras (pytest, ruff, mypy) plus the test suite and the
# pyproject.toml that carries their configuration. The local compose stack
# targets this stage so `make test|lint|typecheck` work without a host
# Python install — README prereqs list Python as "only if you skip Docker".
FROM runtime AS dev

USER root

COPY pyproject.toml ./
COPY --chown=atlas:atlas tests/ ./tests/
# tests/draw + tests/e2e shell out to the standalone proof verifier.
COPY --chown=atlas:atlas tools/ ./tools/

RUN pip install --no-cache-dir ".[dev]"

# ruff/mypy/pytest write their caches into the working directory, so it must
# be writable by the unprivileged runtime user.
RUN chown -R atlas:atlas /app

USER atlas

# ── Default stage ─────────────────────────────────────────────────────────
# A build that omits --target resolves to the LAST stage. Alias it to the
# slim runtime so an untargeted `docker build` can never ship pytest/ruff/
# mypy into a production image. Production builds should still pass
# --target runtime explicitly.
FROM runtime AS production
