# Atlas V0.5 — env var names only, per ADR-012 §Locality.
# Copy to `.env` and fill in dev values. `.env` is gitignored.
# Every variable here MUST also be declared in backend/src/atlas/config.py.

# ── Environment ───────────────────────────────────────────────────────────
ATLAS_ENV=dev

# ── Postgres (docker-compose default user/db) ─────────────────────────────
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas_dev_password
ATLAS_POSTGRES_DB=atlas
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev_password@localhost:5432/atlas

# ── HTTP ──────────────────────────────────────────────────────────────────
ATLAS_HTTP_HOST=0.0.0.0
ATLAS_HTTP_PORT=8000

# ── Identity (required from Day 3) ────────────────────────────────────────
# Both must be >= 32 chars. Generate with: openssl rand -hex 32
# NEVER commit real values; docker-compose sets dev defaults for local runs.
ATLAS_JWT_SIGNING_KEY=
ATLAS_OTP_PEPPER=
ATLAS_SESSION_TTL_HOURS=8

# ── Wallet (V0.5 — real draws exist from Week 5 Day 1) ───────────────────
# Must be false in production (validator enforces). Default is false in
# dev + test now that real draws.id rows exist; the wallet.record_ticket_
# purchase helper is dormant in V0.5 (per week-5-build-plan §0 ask 1).
ATLAS_WALLET_ALLOW_STUB_DRAW=false

# ── Payment / Paystack (Week 4) ───────────────────────────────────────────
# V0.5 stub mode: adapter short-circuits to fixture responses, no real HTTP
# calls to Paystack. Founder decision 2026-07-15 §0.1. Flip to false in
# Week 5 when the mobile ticket-purchase UI needs a real checkout URL.
# ATLAS_PAYSTACK_STUB_MODE=true
# Secret + public key optional in stub mode; required when stub_mode is off.
# ATLAS_PAYSTACK_SECRET_KEY=
# ATLAS_PAYSTACK_PUBLIC_KEY=
# Webhook secret required always — Day 4 exercises the real HMAC-SHA-512
# path against locally-generated signatures. Must be >= 16 chars.
ATLAS_PAYSTACK_WEBHOOK_SECRET=

# ── Demo mode (Week 7) ─────────────────────────────────────────────────────
# When true, seed_v0_5.py compresses close_time to now+10min so investor
# pitches don't wait 3 days. Must be false in production (validator).
ATLAS_DEMO_MODE=false

# ── Draw / entropy (Week 6) ───────────────────────────────────────────────
# Founder decision 2026-07-27 §0.1: hybrid — stub in tests+CI, live in demo.
# Production must be 'live' (validator enforces).
# ATLAS_DRAW_ENTROPY_MODE=stub
# Drand mainnet group public key — persisted for V1 client-side BLS verify.
# See https://drand.love/developer/http-api/#chain-info
# ATLAS_DRAND_GROUP_PUBLIC_KEY=

# ── Later weeks (leave blank until wired) ─────────────────────────────────
# ATLAS_BVN_PEPPER=
# ATLAS_SENTRY_DSN=

# ── Admin superadmin bootstrap (Day 5) ────────────────────────────────────
# Consumed by infrastructure/scripts/bootstrap_superadmin.py.
# Password must be >= 12 chars. Change these for anything but a throwaway
# demo environment.
ATLAS_SUPERADMIN_EMAIL=adaobi.ibe@atlas.dev
ATLAS_SUPERADMIN_PASSWORD=
